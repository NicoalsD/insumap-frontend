# Archivos que no se versionan en insumap-frontend
node_modules
dist/
dist-ssr/
.vite/
coverage/
playwright-report/
test-results/
blob-report/
*.local
.env
.env.*
!.env.example
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
*.log
npm-debug.log*

# Impeccable: solo se versionan el contrato de dirección y la configuración
.impeccable/*
!.impeccable/direction.md
!.impeccable/config*
