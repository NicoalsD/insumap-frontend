# Public build variables only (Vite exposes every VITE_* value to the browser).
# Never put a secret here.

# Base URL of the Insumap API, including the /api/v1 prefix.
# A relative path keeps the API on the same site (needed for the SameSite=Strict refresh cookie).
VITE_API_BASE_URL=/api/v1

# "true" starts Mock Service Worker with the fixtures in src/mocks (demo without a backend).
VITE_USE_MOCKS=true
