# Variables públicas de Vite (nunca pongas un secreto en una variable VITE_*).

# URL base de la API incluyendo /api/v1. Relativa mantiene el mismo sitio (cookie SameSite=Strict).
VITE_API_BASE_URL=/api/v1

# "true" arranca Mock Service Worker con fixtures ficticias (sin backend).
VITE_USE_MOCKS=true

# Correo comercial que recibe las solicitudes de demostración de la landing (dirección pública).
VITE_SALES_EMAIL=
